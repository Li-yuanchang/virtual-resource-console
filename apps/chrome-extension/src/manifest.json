{
  "manifest_version": 3,
  "name": "VRC",
  "short_name": "VRC",
  "version": "0.1.3",
  "description": "连接本机或内网 VRC 服务的浏览器入口。",
  "key": "",
  "permissions": ["storage", "tabs", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/vrc-16.png",
    "32": "icons/vrc-32.png",
    "48": "icons/vrc-48.png",
    "128": "icons/vrc-128.png"
  },
  "action": {
    "default_title": "VRC",
    "default_icon": {
      "16": "icons/vrc-16.png",
      "32": "icons/vrc-32.png",
      "48": "icons/vrc-48.png",
      "128": "icons/vrc-128.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
