{
  "manifest_version": 3,
  "name": "Virtual Resource Console",
  "version": "0.1.0",
  "description": "Connect to a local or intranet Virtual Resource Console service.",
  "key": "",
  "permissions": ["storage", "tabs", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Virtual Resource Console",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
